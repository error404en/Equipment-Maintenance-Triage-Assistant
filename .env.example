# ---------------------------------------------------------
# Equipment Maintenance Triage Assistant - Configuration
# ---------------------------------------------------------

# DATABASE_URL (Required)
# Connection string for the PostgreSQL database.
# Example: postgresql+psycopg://user:password@localhost:5432/triage
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/triage

# GROQ_API_KEY (Optional)
# API key for Groq to run the AI analysis. If omitted, the system falls back
# to rules-only deterministic mode.
# Example: gsk_xxxxxxxxxxxxxxxxx
GROQ_API_KEY=

# GROQ_MODEL (Optional)
# Model to use for the AI analysis. Defaults to openai/gpt-oss-120b or llama-3.3-70b-versatile
# Example: llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# ALLOWED_ORIGINS (Optional)
# Comma-separated list of origins for CORS. Leave empty for single-origin deployments.
# Example: http://localhost:5173,https://my-frontend.com
ALLOWED_ORIGINS=

# LOG_LEVEL (Optional)
# Application logging verbosity.
# Example: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
