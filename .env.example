# Local development defaults — copy to .env and adjust as needed.
# NEVER commit .env to source control.

# --- Database ---
# For local dev (without Docker Compose): connect to local Postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/triage
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/triage_test

# Password used by docker-compose to start Postgres.
# Override to avoid using the insecure default in shared/production environments.
POSTGRES_PASSWORD=postgres

# --- CORS ---
# Comma-separated list of allowed origins.
# Leave empty (the default) when FastAPI serves the built frontend from the same origin.
# Set to your frontend domain only when the frontend is on a different host/port.
ALLOWED_ORIGINS=

# --- AI (future) ---
# Set to enable the Groq advisory engine. Empty = rules-only mode (safe default).
#GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
